#version 450

//------------------------------------------------------------------------------
// 体绘制（光线步进）—— compute shader 实现
//
// 与旧的“片元链表”体绘制（VolumeRenderingLink.frag / VolumeRenderingSort.frag）
// 不同，这里不再依赖光栅化产生的片元：
//   1. 每个 invocation 负责一个像素；
//   2. 从相机出发构造光线，与体包围盒求交得到 [tNear, tFar]；
//   3. 沿光线步进采样 3D 纹理（三线性插值）；
//   4. 用传输函数（1D LUT）取得颜色与不透明度；
//   5. 前后向积分（front-to-back）累积颜色，透射率低于阈值提前退出；
//   6. 与背景色合成后写入 image2D。
//
// 说明：
//   * 体数据在 CPU 侧已归一化到 [0, 1]，shader 中直接作为传输函数查表坐标；
//   * 采样步长按体素步长做不透明度补偿，保证步数变化时浓淡基本一致；
//   * 起始位置加入抖动，避免固定步长产生的层状伪影（后续可替换为时间累积）。
//------------------------------------------------------------------------------

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 0) uniform CameraDataBlock {
    vec3 viewPos;
    int isOrtho;
    vec4 orthoBounds;
    float zNear;
    float zFar;
    mat4 view;
    mat4 proj;
    mat4 proj_view;// proj * view
} cameraData;

// 世界空间 -> 体纹理空间（[0,1]^3）的仿射变换
uniform mat4 worldToTexture;
// 裁剪空间 -> 世界空间（用于反投影重建光线）
uniform mat4 invProjView;

uniform int numSteps;         // 每条光线的最大采样步数
uniform float opacityScale;   // 整体不透明度缩放（调节浓淡）
uniform float jitterSeed;     // 每帧变化，用于抖动采样起点
uniform vec3 backgroundColor; // 体后方的背景色（体数据独立渲染时使用）
uniform int debugMode;        // 0=正常渲染；1=输出命中诊断（一次性 GPU 自检用）

uniform sampler3D volumeTexture;   // 体数据（R16F，三线性插值）
uniform sampler3D volumeMask;      // 体数据掩膜（R32F：1=有效，0=无效）
uniform int volumeMaskEnabled;     // 掩膜是否可用（0 时完全跳过掩膜采样）
uniform sampler3D volumeMask2;     // 第二层掩膜（R32F：1=有效，0=无效）
uniform int volumeMask2Enabled;    // 第二层掩膜是否启用
uniform int maskMode;              // 1=挖空无效体素；2=把无效体素画成实体车壳
uniform int maskMode2;             // 第二层掩膜模式
uniform float shellOpacity;        // 车壳实体模式的外壳不透明度
uniform float shellOpacity2;       // 第二层车壳实体不透明度
uniform vec3 shellColor;           // 车壳实体颜色
uniform sampler2D transferFunction;// 传输函数 LUT（256x1 RGBA8）

// 第二体层（可选）：两个可见结构化模型一起体绘制
uniform sampler3D volumeTexture2;  // 第二层体数据（R16F）
uniform sampler2D transferFunction2; // 第二层传输函数 LUT
uniform mat4 worldToTexture2;      // 第二层世界 -> 纹理空间
uniform int layerCount;            // 1 = 单层；2 = 第二层参与
uniform int layer0On;              // 第一层用户开关
uniform int layer1On;              // 第二层用户开关
uniform float opacityScale2;       // 第二层自己的不透明度缩放

layout(binding = 0, rgba8) uniform writeonly image2D outImage;

// 简单的散列函数，用于抖动采样起点
float Hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// 稳健的 slab 求交（纹理空间单位立方体）：方向分量接近 0 时退化成“是否在板内”，
// 否则 1/0 会得到 ±inf、0*inf 会得到 NaN，导致误判为不相交
bool IntersectVolumeSlab(vec3 oT, vec3 dT, out float tNear, out float tFar) {
    tNear = 0.0;
    tFar = 1.0e30;
    for (int axis = 0; axis < 3; ++axis) {
        float o = oT[axis];
        float d = dT[axis];
        if (abs(d) < 1.0e-8) {
            if (o < 0.0 || o > 1.0) { return false; }
        } else {
            float t0 = (0.0 - o) / d;
            float t1 = (1.0 - o) / d;
            tNear = max(tNear, min(t0, t1));
            tFar = min(tFar, max(t0, t1));
        }
    }
    return tFar > tNear;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outImage);
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y) { return; }

    // 1. 像素坐标 -> NDC -> 世界空间光线
    //    注意：引擎使用反向 Z（igm::perspectiveRH_OZ / orthoRH_OZ，
    //    深度范围 1.0(近) -> 0.0(远)），因此 ndc.z = +1 是近平面、
    //    ndc.z = 0 是远平面。
    //    注意不要用 ndc.z = -1：本引擎的透视投影是“有限远平面 + 反向 Z”，
    //    默认视角（相机位于 center+3r，near=2r，far=4r）下投影矩阵中
    //    zNear/(zFar-zNear) 恰好等于 1，此时 ndc.z=-1 反投影的齐次 w 为 0，
    //    会得到 NaN/inf 的远点，使光线方向非法、体绘制整屏不可见。
    vec2 ndc = (vec2(pixel) + vec2(0.5)) / vec2(imageSize) * 2.0 - 1.0;

    vec4 nearPoint = invProjView * vec4(ndc, 1.0, 1.0);
    vec4 farPoint = invProjView * vec4(ndc, 0.0, 1.0);
    nearPoint /= nearPoint.w;
    farPoint /= farPoint.w;

    // 统一用反投影出的近/远平面点构造光线：两点都在该像素的光线上，
    // 因此对透视与正交都成立，且不依赖 UBO 里的相机位置（避免其状态问题）。
    // 起点取近平面点，等于顺便跳过相机到近平面之间的空段。
    vec3 rayOrigin = vec3(0.0);
    vec3 rayDir = vec3(0.0, 0.0, -1.0);
    bool rayValid = false;

    vec3 forwardVec = farPoint.xyz - nearPoint.xyz;
    if (dot(forwardVec, forwardVec) > 1.0e-12) {
        rayOrigin = nearPoint.xyz;
        rayDir = normalize(forwardVec);
        rayValid = true;
    } else {
        // 近/远点重合（例如无限远反向 Z 投影）：退回用相机位置构造
        vec3 cameraPos = cameraData.viewPos;
        vec3 toNear = nearPoint.xyz - cameraPos;
        if (dot(toNear, toNear) > 1.0e-12) {
            rayOrigin = cameraPos;
            rayDir = normalize(toNear);
            rayValid = true;
        }
    }

    if (!rayValid) {
        imageStore(outImage, pixel, vec4(backgroundColor, 1.0));
        return;
    }

    // 2. 变换到体纹理空间：仿射变换保持参数 t 不变，
    //    因此可以直接在纹理空间做 slab 求交，得到世界参数下的 [tNear, tFar]
    vec3 oT = (worldToTexture * vec4(rayOrigin, 1.0)).xyz;
    vec3 dT = (worldToTexture * vec4(rayDir, 0.0)).xyz;
    float tNear0 = 0.0;
    float tFar0 = 0.0;
    bool hit0 = layer0On == 1 && IntersectVolumeSlab(oT, dT, tNear0, tFar0);

    // 第二层：单独一套纹理空间变换（与第一层共享场景模型矩阵）
    vec3 oT2 = vec3(0.0);
    vec3 dT2 = vec3(0.0);
    float tNear1 = 0.0;
    float tFar1 = 0.0;
    bool hit1 = false;
    if (layerCount > 1 && layer1On == 1) {
        oT2 = (worldToTexture2 * vec4(rayOrigin, 1.0)).xyz;
        dT2 = (worldToTexture2 * vec4(rayDir, 0.0)).xyz;
        hit1 = IntersectVolumeSlab(oT2, dT2, tNear1, tFar1);
    }

    // 一条光线按所有体积的并集步进
    bool hit = hit0 || hit1;
    float tNear = hit0 ? tNear0 : tNear1;
    float tFar = hit0 ? tFar0 : tFar1;
    if (hit0 && hit1) {
        tNear = min(tNear0, tNear1);
        tFar = max(tFar0, tFar1);
    }

    if (debugMode == 1) {
        // 一次性 GPU 自检输出：R = 是否命中，G = tNear/100，B = tFar/100
        imageStore(outImage, pixel,
                   vec4(hit ? 1.0 : 0.0, clamp(tNear / 100.0, 0.0, 1.0),
                        clamp(tFar / 100.0, 0.0, 1.0), 1.0));
        return;
    }

    if (!hit || tFar <= tNear) {
        // 光线与体数据不相交
        imageStore(outImage, pixel, vec4(backgroundColor, 1.0));
        return;
    }

    // 3. 步长与不透明度补偿
    vec3 volumeDim = vec3(textureSize(volumeTexture, 0));
    float referenceStep = 1.0 / max(volumeDim.x, max(volumeDim.y, volumeDim.z));

    int steps = max(numSteps, 1);
    float dt = (tFar - tNear) / float(steps);
    float textureStep = length(dT) * dt;      // 单步在纹理空间的长度
    float opacityCorrection = textureStep / referenceStep;

    float jitter = Hash12(vec2(pixel) + vec2(jitterSeed));
    float t = tNear + dt * jitter;

    // 4. 前后向积分：C += T * a * c; T *= (1 - a)
    vec3 accumulated = vec3(0.0);
    float transmittance = 1.0;

    for (int i = 0; i < steps; ++i) {
        vec3 rgb = vec3(0.0);
        float alpha = 0.0;

        // 第一层：标量 + 掩膜/车壳
        if (hit0) {
            vec3 texCoord = oT + dT * t;
            if (all(greaterThanEqual(texCoord, vec3(0.0))) &&
                all(lessThanEqual(texCoord, vec3(1.0)))) {
                float scalar =
                        clamp(texture(volumeTexture, texCoord).r, 0.0, 1.0);
                vec4 tf = texture(transferFunction, vec2(scalar, 0.5));
                rgb = tf.rgb;
                alpha = clamp(tf.a * opacityScale, 0.0, 1.0);

                // 掩膜（1 = 有效流体，0 = 无效/车体）
                //   maskMode == 1 挖空：无效体素完全不贡献
                //   maskMode == 2 车壳实体：无效体素用固定颜色画成实体
                if (volumeMaskEnabled == 1) {
                    float mask = texture(volumeMask, texCoord).r;
                    if (maskMode == 1) {
                        alpha *= mask;
                    } else if (maskMode == 2) {
                        float shellAlpha =
                                clamp(shellOpacity, 0.0, 1.0) * (1.0 - mask);
                        float alphaSum = alpha + shellAlpha;
                        if (alphaSum > 0.0) {
                            rgb = (alpha * rgb + shellAlpha * shellColor) /
                                  alphaSum;
                            alpha = 1.0 - (1.0 - alpha) * (1.0 - shellAlpha);
                        }
                    }
                }
            }
        }

        // 第二层：标量 + 掩膜/车壳（与第一层同一套模式，各用自己的掩膜），
        // 与第一层在同一采样点做对称合成
        if (layer1On == 1 && hit1) {
            vec3 texCoord2 = oT2 + dT2 * t;
            if (all(greaterThanEqual(texCoord2, vec3(0.0))) &&
                all(lessThanEqual(texCoord2, vec3(1.0)))) {
                float scalar2 =
                        clamp(texture(volumeTexture2, texCoord2).r, 0.0, 1.0);
                vec4 tf2 = texture(transferFunction2, vec2(scalar2, 0.5));
                vec3 rgb2 = tf2.rgb;
                float alpha2 = clamp(tf2.a * opacityScale2, 0.0, 1.0);
                if (volumeMask2Enabled == 1) {
                    float mask2 = texture(volumeMask2, texCoord2).r;
                    if (maskMode2 == 1) {
                        alpha2 *= mask2;
                    } else if (maskMode2 == 2) {
                        float shellAlpha2 =
                                clamp(shellOpacity2, 0.0, 1.0) * (1.0 - mask2);
                        float alphaSum2 = alpha2 + shellAlpha2;
                        if (alphaSum2 > 0.0) {
                            rgb2 = (alpha2 * rgb2 + shellAlpha2 * shellColor) /
                                   alphaSum2;
                            alpha2 = 1.0 - (1.0 - alpha2) * (1.0 - shellAlpha2);
                        }
                    }
                }
                float alphaSum = alpha + alpha2;
                if (alphaSum > 0.0) {
                    rgb = (alpha * rgb + alpha2 * rgb2) / alphaSum;
                    alpha = 1.0 - (1.0 - alpha) * (1.0 - alpha2);
                }
            }
        }

        if (alpha > 0.0) {
            // 按实际步长补偿不透明度，使结果与步数基本无关
            alpha = 1.0 - pow(1.0 - alpha, opacityCorrection);
            accumulated += transmittance * alpha * rgb;
            transmittance *= (1.0 - alpha);
            if (transmittance < 0.01) { break; } // 提前终止
        }

        t += dt;
    }

    // 5. 剩余透射率显示出背景色
    vec3 color = accumulated + transmittance * backgroundColor;
    imageStore(outImage, pixel, vec4(color, 1.0));
}
