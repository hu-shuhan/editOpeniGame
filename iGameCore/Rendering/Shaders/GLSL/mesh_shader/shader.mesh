#version 460

#extension GL_NV_mesh_shader : require
//#extension GL_NV_gpu_shader5 : require

#define MAX_VERTEX_COUNT 64
#define MAX_PRIMITIVE_COUNT 124
#define GROUP_SIZE 32

const uint vertexLoops = (MAX_VERTEX_COUNT + GROUP_SIZE - 1) / GROUP_SIZE;
const uint primreadLoops = (MAX_PRIMITIVE_COUNT * 3 + GROUP_SIZE * 4 - 1) / (GROUP_SIZE * 4);

layout(local_size_x = GROUP_SIZE) in;

layout(triangles) out;

layout(max_vertices = MAX_VERTEX_COUNT, max_primitives = MAX_PRIMITIVE_COUNT) out;

// Camera buffer
layout(std140, binding = 0) uniform CameraDataBlock {
    vec3 viewPos;
    int isOrtho;
    mat4 view;
    mat4 proj;
    mat4 proj_view;// proj * view
} cameraData;

// Meshlets Buffer
struct Meshlet {
    uint vertex_offset;
    uint triangle_offset;

    uint vertex_count;
    uint triangle_count;
};
layout(std430, binding = 1) readonly buffer MeshletsBuffer {
    Meshlet meshlets[];
} meshletsBuffer;

layout(std430, binding = 2) readonly buffer MeshletVertexBuffer {
    uint meshlet_vertices[];
} meshletVertexBuffer;

layout(std430, binding = 3) readonly buffer MeshletTriangleBuffer {
    uint meshlet_triangles[];
} meshletTriangleBuffer;

// in vertex information
layout(std430, binding = 4) readonly buffer PositionBuffer {
    float data[];// vec3
} positionBuffer;

layout(std430, binding = 5) readonly buffer ColorBuffer {
    float data[];// vec3
} colorBuffer;

layout(std430, binding = 6) readonly buffer NormalBuffer {
    float data[];// vec3
} normalBuffer;

layout(std430, binding = 7) readonly buffer UVBuffer {
    float data[];// vec2
} uvBuffer;

//// out for fargment shader
//out PerVertexData {
//    vec4 color;
//} v_out[];
//
//const vec3 vertices[3] = { vec3(-1, -1, 0), vec3(0, 1, 0), vec3(1, -1, 0) };
//const vec3 colors[3] = { vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0) };
//
//uniform float scale;

void main()
{
    uint groupIndex = gl_WorkGroupID.x;
    uint groupThreadIndex = gl_LocalInvocationID.x;

    Meshlet meshlet = meshletsBuffer.meshlets[groupIndex];

    for (uint loop = 0; loop < vertexLoops; ++loop) {
        uint localVertexIndex = groupThreadIndex + loop * GROUP_SIZE;
        localVertexIndex = min(localVertexIndex, meshlet.vertex_count - 1);

        uint vertexIndex = meshletVertexBuffer.meshlet_vertices[meshlet.vertex_offset + localVertexIndex];

        uint offset = vertexIndex * 3;
        float x = positionBuffer.data[offset];
        float y = positionBuffer.data[offset + 1];
        float z = positionBuffer.data[offset + 2];
        vec4 vertexPosition = vec4(x, y, z, 1.0f);
        gl_MeshVerticesNV[localVertexIndex].gl_Position = vertexPosition;
    }

    uint packedTriangleBegin = meshlet.triangle_offset / 4;
    uint packedTriangleMax = (3 * meshlet.triangle_count - 1) / 4;
    for (uint loop = 0; loop < primreadLoops; ++loop) {
        uint localTriangleIndex = groupThreadIndex + loop * GROUP_SIZE;
        localTriangleIndex = min(localTriangleIndex, packedTriangleMax);

        uint offset = packedTriangleBegin + localTriangleIndex;
        writePackedPrimitiveIndices4x8NV(4 * localTriangleIndex, meshletTriangleBuffer.meshlet_triangles[offset]);
    }

    if (groupThreadIndex == 0) {
        gl_PrimitiveCountNV = meshlet.triangle_count;
    }

    //    gl_MeshVerticesNV[0].gl_Position = vec4(vertices[0] * scale, 1.0);
    //    gl_MeshVerticesNV[1].gl_Position = vec4(vertices[1] * scale, 1.0);
    //    gl_MeshVerticesNV[2].gl_Position = vec4(vertices[2] * scale, 1.0);
    //
    //    v_out[0].color = vec4(colors[0], 1.0);
    //    v_out[1].color = vec4(colors[1], 1.0);
    //    v_out[2].color = vec4(colors[2], 1.0);
    //
    //    gl_PrimitiveIndicesNV[0] = 0;
    //    gl_PrimitiveIndicesNV[1] = 1;
    //    gl_PrimitiveIndicesNV[2] = 2;
    //
    //    gl_PrimitiveCountNV = 1;
}