#----------------------------------------------
# Find ThirdParty lib and Core Components Lib
#----------------------------------------------
foreach(LIB ${IGAMEVIS_CORE_LIB_LIST})
    set(temp${LIB})

    if(WIN32)
        find_library(temp${LIB}
                NAMES
                "${LIB}.lib"
     #           PATHS
                HINTS
                ${IGAMEVIS_CORE_PRIVATE_LIB}
     #           NO_CMAKE_FIND_ROOT_PATH
        )

    else()
        find_library(temp${LIB}
                    NAMES
                    "lib${LIB}.a"
         #           PATHS
                    HINTS
                    ${IGAMEVIS_CORE_PRIVATE_LIB}
         #           NO_CMAKE_FIND_ROOT_PATH
                )
    endif()
    if(temp${LIB})
#        message(WARNING ${temp${LIB}})
        mark_as_advanced(temp${LIB})
            list(APPEND FOUND_IGAMEVIS_CORE_LIB_FULL_PATH ${temp${LIB}})

            if (NOT TARGET @MODULE_NAME@::${LIB})
                add_library(@MODULE_NAME@::${LIB} UNKNOWN IMPORTED)
                set_target_properties(@MODULE_NAME@::${LIB}
                        PROPERTIES
                        IMPORTED_LOCATION ${temp${LIB}}
                        INTERFACE_INCLUDE_DIRECTORIES "${IGAMEVIS_CORE_INCLUDE_DIRS}")
                list(APPEND IGAMEVIS_CORE_LIB_TARGETS @MODULE_NAME@::${LIB})
            endif ()
    endif()
endforeach()

if(@ENABLE_GPSCUDA_MODULE@ AND CUDAToolkit_FOUND)
    # (CUDAToolkit_FOUND 变量是在文件顶部设置的)

    find_library(CUDA_cudart_lib NAMES cudart
        HINTS ${CUDAToolkit_LIBRARY_DIR}
        PATH_SUFFIXES lib/x64 lib64
        NO_DEFAULT_PATH
    )
    find_library(CUDA_cudadevrt_lib NAMES cudadevrt
        HINTS ${CUDAToolkit_LIBRARY_DIR}
        PATH_SUFFIXES lib/x64 lib64
        NO_DEFAULT_PATH
    )

    if(CUDA_cudart_lib AND CUDA_cudadevrt_lib)
        message(STATUS "iGameCore: Found CUDA runtime libraries for linking.")

        # 1. 将其添加到最终的库路径列表中
        list(APPEND FOUND_IGAMEVIS_CORE_LIB_FULL_PATH ${CUDA_cudart_lib} ${CUDA_cudadevrt_lib})

        # 2. 为它们创建 IMPORTED 目标并添加到目标列表
        if (NOT TARGET @MODULE_NAME@::cudart)
            add_library(@MODULE_NAME@::cudart UNKNOWN IMPORTED)
            set_target_properties(@MODULE_NAME@::cudart PROPERTIES IMPORTED_LOCATION ${CUDA_cudart_lib})
            list(APPEND IGAMEVIS_CORE_LIB_TARGETS @MODULE_NAME@::cudart)
        endif()

        if (NOT TARGET @MODULE_NAME@::cudadevrt)
            add_library(@MODULE_NAME@::cudadevrt UNKNOWN IMPORTED)
            set_target_properties(@MODULE_NAME@::cudadevrt PROPERTIES IMPORTED_LOCATION ${CUDA_cudadevrt_lib})
            list(APPEND IGAMEVIS_CORE_LIB_TARGETS @MODULE_NAME@::cudadevrt)
        endif()

    else()
        message(WARNING "iGameCore: Could not find cudart.lib or cudadevrt.lib in ${CUDAToolkit_LIBRARY_DIR}. "
                        "Linking C++-only projects may fail with LNK2019 errors.")
    endif()
endif()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(@MODULE_NAME@
        REQUIRED_VARS
        FOUND_IGAMEVIS_CORE_LIB_FULL_PATH
        IGAMEVIS_CORE_INCLUDE_DIRS)
