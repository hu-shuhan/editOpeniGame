if(@ENABLE_GPSCUDA_MODULE@)
    message(STATUS "iGameCore: Configuring with GPSCUDA (GPSpline) module.")

    # 1. 添加 GPSpline 相关的 include 路径
    list(APPEND IGAMEVIS_CORE_INCLUDE_DIRS
        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern"
        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern/wmma_extension/include"
#        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern/cutlass/include"
 #       "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern/cutlass/tools/util/include"
        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern/oneTBB-2021.10.0/include"
        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/extern/glm"
        "${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/CMakeGPS/GPSpline"
    )

    # 2. 重新查找 CUDA (这是“老方式”的必要妥协)
    #    因为 GPSplineLib 依赖 CUDA
    find_package(CUDAToolkit QUIET)
        if(CUDAToolkit_FOUND)
            message(STATUS "iGameCore: Found CUDAToolkit for GPSpline dependency.")
            list(APPEND IGAMEVIS_CORE_INCLUDE_DIRS ${CUDAToolkit_INCLUDE_DIRS})

        else()
            message(WARNING "iGameCore: CUDAToolkit not found. "
                            "The project using igamecore_ MUST run 'find_package(CUDAToolkit REQUIRED)' itself "
                            "before linking to iGameCore.")
    endif()
endif()

