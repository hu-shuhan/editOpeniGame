# Copy Nastran converter executable to build directory
if(@ENABLE_NASTRAN_MODULE@)
    # Get absolute path for install directory
    get_filename_component(IGAMEVIS_INSTALL_DIR_ABS "${IGAMEVIS_INSTALL_DIR}" ABSOLUTE)
    set(NASTRAN_CONVERTER_SOURCE "${IGAMEVIS_INSTALL_DIR_ABS}/bin/NastranConverter/nastran_to_vtk_cli.exe")


    if(EXISTS "${NASTRAN_CONVERTER_SOURCE}")
        file(COPY "${NASTRAN_CONVERTER_SOURCE}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}")
    else()
        message(WARNING "could not Find NastranConverter: ${NASTRAN_CONVERTER_SOURCE}")
    endif()
endif()

