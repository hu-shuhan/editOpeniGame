    list(APPEND OPENIGAME_CORE_INCLUDE_DIRS
    ${OPENIGAME_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/FFMPEG/include
)
    list(APPEND OPENIGAME_CORE_PRIVATE_LIB ${OPENIGAME_INSTALL_DIR}/lib/ThirdParty/FFMPEG)
endif()

file(GLOB_RECURSE OPENIGAME_CORE_3RD_DLL_FILES CONFIGURE_DEPENDS ${OPENIGAME_INSTALL_DIR}/bin/*.dll)
file(COPY ${OPENIGAME_CORE_3RD_DLL_FILES} DESTINATION ${CMAKE_BINARY_DIR})

set(RENDERING_ASSESTS_SOURCE_DIR ${OPENIGAME_INSTALL_DIR}/Resources/Assests)
set(RENDERING_SHADERS_SOURCE_DIR ${OPENIGAME_INSTALL_DIR}/Resources/Shaders/GLSL)
set(RENDERING_RESOURCES_OUTPUT_DIR ${CMAKE_BINARY_DIR}/Resources)

file(MAKE_DIRECTORY ${RENDERING_RESOURCES_OUTPUT_DIR})
file(COPY ${RENDERING_ASSESTS_SOURCE_DIR}/ DESTINATION ${RENDERING_RESOURCES_OUTPUT_DIR}/Assests)
file(COPY ${RENDERING_SHADERS_SOURCE_DIR}/ DESTINATION ${RENDERING_RESOURCES_OUTPUT_DIR}/Shaders)


mark_as_advanced(OPENIGAME_CORE_PRIVATE_INCLUDE_DIR)
mark_as_advanced(OPENIGAME_CORE_INCLUDE_DIRS)
mark_as_advanced(OPENIGAME_CORE_PRIVATE_LIB)

set(OpeniGame_CORE_LIB_LIST
        @MODULE_NAME@
        @ThirdParty_lib_dependency@
        glfw3

)
set(FOUND_OPENIGAME_CORE_LIB_FULL_PATH)
set(OPENIGAME_CORE_LIB_TARGETS)

#----------------------------------------------
# Find CGNS Package
#----------------------------------------------
if(@ENABLE_CGNS_MODULE@)
list(APPEND OpeniGame_CORE_LIB_LIST
    cgns

    libhdf5
    libaec
    libhdf5_hl
    libhdf5_tools
    libzlib
    libsz
)
endif()




#----------------------------------------------
# Find ThirdParty lib and Core Components Lib
#----------------------------------------------
foreach(LIB ${OpeniGame_CORE_LIB_LIST})
    set(temp${LIB})
    find_library(temp${LIB}
            NAMES
            "${LIB}.lib"
 #           PATHS
            HINTS
            ${OPENIGAME_CORE_PRIVATE_LIB}
 #           NO_CMAKE_FIND_ROOT_PATH
    )
    if(temp${LIB})
#        message(WARNING ${temp${LIB}})
        mark_as_advanced(temp${LIB})
            list(APPEND FOUND_OPENIGAME_CORE_LIB_FULL_PATH ${temp${LIB}})

            if (NOT TARGET @MODULE_NAME@::${LIB})
                add_library(@MODULE_NAME@::${LIB} UNKNOWN IMPORTED)
                set_target_properties(@MODULE_NAME@::${LIB}
                        PROPERTIES
                        IMPORTED_LOCATION ${temp${LIB}}
                        INTERFACE_INCLUDE_DIRECTORIES "${OPENIGAME_CORE_INCLUDE_DIRS}")
                list(APPEND OPENIGAME_CORE_LIB_TARGETS @MODULE_NAME@::${LIB})
            endif ()
    endif()
endforeach()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(@MODULE_NAME@
        REQUIRED_VARS
        FOUND_OPENIGAME_CORE_LIB_FULL_PATH
        OPENIGAME_CORE_INCLUDE_DIRS)