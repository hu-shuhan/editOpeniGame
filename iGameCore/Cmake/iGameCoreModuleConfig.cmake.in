    list(APPEND OPENIGAME_CORE_INCLUDE_DIRS
    ${OPENIGAME_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/AbaqusSDK/include
    ${OPENIGAME_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/AbaqusSDK/2024
)
    list(APPEND OPENIGAME_CORE_PRIVATE_LIB ${OPENIGAME_INSTALL_DIR}/lib/ThirdParty/AbaqusSDK)
