    ${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/AbaqusSDK/2024
)
    list(APPEND IGAMEVIS_CORE_PRIVATE_LIB ${IGAMEVIS_INSTALL_DIR}/lib/ThirdParty/AbaqusSDK)
endif()
