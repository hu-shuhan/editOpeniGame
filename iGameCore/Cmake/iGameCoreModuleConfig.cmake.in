    list(APPEND IGAMEVIS_CORE_INCLUDE_DIRS
    ${IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR}/ThirdParty/FFMPEG/include
)
    list(APPEND IGAMEVIS_CORE_PRIVATE_LIB ${IGAMEVIS_INSTALL_DIR}/lib/ThirdParty/FFMPEG)
endif()

file(GLOB_RECURSE IGAMEVIS_CORE_3RD_DLL_FILES CONFIGURE_DEPENDS ${IGAMEVIS_INSTALL_DIR}/bin/*.dll)
file(COPY ${IGAMEVIS_CORE_3RD_DLL_FILES} DESTINATION ${CMAKE_BINARY_DIR})

set(RENDERING_ASSESTS_SOURCE_DIR ${IGAMEVIS_INSTALL_DIR}/Resources/Assests)
set(RENDERING_SHADERS_SOURCE_DIR ${IGAMEVIS_INSTALL_DIR}/Resources/Shaders/GLSL)
set(RENDERING_RESOURCES_OUTPUT_DIR ${CMAKE_BINARY_DIR}/Resources)

file(MAKE_DIRECTORY ${RENDERING_RESOURCES_OUTPUT_DIR})
file(COPY ${RENDERING_ASSESTS_SOURCE_DIR}/ DESTINATION ${RENDERING_RESOURCES_OUTPUT_DIR}/Assests)
file(COPY ${RENDERING_SHADERS_SOURCE_DIR}/ DESTINATION ${RENDERING_RESOURCES_OUTPUT_DIR}/Shaders)


mark_as_advanced(IGAMEVIS_CORE_PRIVATE_INCLUDE_DIR)
mark_as_advanced(IGAMEVIS_CORE_INCLUDE_DIRS)
mark_as_advanced(IGAMEVIS_CORE_PRIVATE_LIB)

set(IGAMEVIS_CORE_LIB_LIST
        @MODULE_NAME@
        @ThirdParty_lib_dependency@
        glfw3

)
set(FOUND_IGAMEVIS_CORE_LIB_FULL_PATH)
set(IGAMEVIS_CORE_LIB_TARGETS)

#----------------------------------------------
# Find CGNS Package
#----------------------------------------------
if(@ENABLE_CGNS_MODULE@)
list(APPEND IGAMEVIS_CORE_LIB_LIST
    cgns

    libhdf5
    libaec
    libhdf5_hl
    libhdf5_tools
    libzlib
    libsz
)
endif()




#----------------------------------------------
# Find ThirdParty lib and Core Components Lib
#----------------------------------------------
foreach(LIB ${IGAMEVIS_CORE_LIB_LIST})
    set(temp${LIB})

    if()
        find_library(temp${LIB}
                NAMES
                "${LIB}.lib"
     #           PATHS
                HINTS
                ${IGAMEVIS_CORE_PRIVATE_LIB}
     #           NO_CMAKE_FIND_ROOT_PATH
        )

    else()
        find_library(temp${LIB}
                    NAMES
                    "lib${LIB}.a"
         #           PATHS
                    HINTS
                    ${IGAMEVIS_CORE_PRIVATE_LIB}
         #           NO_CMAKE_FIND_ROOT_PATH
                )
    endif()
    if(temp${LIB})
#        message(WARNING ${temp${LIB}})
        mark_as_advanced(temp${LIB})
            list(APPEND FOUND_IGAMEVIS_CORE_LIB_FULL_PATH ${temp${LIB}})

            if (NOT TARGET @MODULE_NAME@::${LIB})
                add_library(@MODULE_NAME@::${LIB} UNKNOWN IMPORTED)
                set_target_properties(@MODULE_NAME@::${LIB}
                        PROPERTIES
                        IMPORTED_LOCATION ${temp${LIB}}
                        INTERFACE_INCLUDE_DIRECTORIES "${IGAMEVIS_CORE_INCLUDE_DIRS}")
                list(APPEND IGAMEVIS_CORE_LIB_TARGETS @MODULE_NAME@::${LIB})
            endif ()
    endif()
endforeach()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(@MODULE_NAME@
        REQUIRED_VARS
        FOUND_IGAMEVIS_CORE_LIB_FULL_PATH
        IGAMEVIS_CORE_INCLUDE_DIRS)