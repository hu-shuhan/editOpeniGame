  <property name="styleSheet">
   <string>/* 半透明深色 + 柔化亮色（与无边框变量相关性弹窗合成） */
igQtVariableCorrelationWidget,
QWidget#igQtVariableCorrelationWidget {
    background-color: rgba(30, 30, 32, 0.88);
}
QScrollArea {
    background-color: rgba(30, 30, 32, 0.82);
    border: none;
}
QScrollArea::viewport {
    background-color: rgba(30, 30, 32, 0.82) !important;
}
/* 勿给 HLine/VLine 铺底，否则与 Line 银色分隔线冲突 */
QScrollArea QFrame:not([frameShape=&quot;4&quot;]):not([frameShape=&quot;5&quot;]),
QScrollArea QWidget {
    background-color: rgba(30, 30, 32, 0.82) !important;
}
QWidget#widget_2,
QWidget#scrollAreaWidgetContents_2 {
    background-color: rgba(30, 30, 32, 0.82) !important;
}
/* 说明性 QLabel：银灰色 + 略大字号（与 cpp ApplyCaptionLabelStyle 一致） */
QWidget#igQtVariableCorrelationWidget QLabel {
    background-color: transparent;
    color: rgba(198, 200, 208, 0.95) !important;
    font-size: 15px;
}
QWidget#igQtVariableCorrelationWidget QLabel#label_10 {
    color: rgba(205, 207, 213, 0.96) !important;
    font-size: 15px;
    font-weight: 600;
    padding-right: 6px;
}
QWidget#igQtVariableCorrelationWidget QLabel#label,
QWidget#igQtVariableCorrelationWidget QLabel#label_2,
QWidget#igQtVariableCorrelationWidget QLabel#label_3,
QWidget#igQtVariableCorrelationWidget QLabel#label_4,
QWidget#igQtVariableCorrelationWidget QLabel#label_5 {
    color: rgba(212, 214, 220, 0.97) !important;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.3px;
    padding: 4px 2px;
}
QWidget#igQtVariableCorrelationWidget QLabel#label_6,
QWidget#igQtVariableCorrelationWidget QLabel#label_7,
QWidget#igQtVariableCorrelationWidget QLabel#label_8,
QWidget#igQtVariableCorrelationWidget QLabel#label_9 {
    color: rgba(198, 200, 208, 0.95) !important;
    font-size: 15px;
    font-weight: 500;
    padding: 2px 0;
}
QWidget#igQtVariableCorrelationWidget QLabel#mainVariableName,
QWidget#igQtVariableCorrelationWidget QLabel#subVariableName,
QWidget#igQtVariableCorrelationWidget QLabel#mainVariablePos,
QWidget#igQtVariableCorrelationWidget QLabel#subVariablePos {
    color: rgba(186, 188, 196, 0.94) !important;
    font-size: 15px;
    font-weight: 500;
}
/* 相关性矩阵内数值 */
QWidget#igQtVariableCorrelationWidget igQtVariableCorrelationWidget_VariableCorrelationLabel {
    color: rgba(220, 222, 230, 0.94) !important;
    font-weight: 500;
    font-size: 15px;
}
QComboBox {
    background-color: rgba(37, 37, 40, 0.88);
    color: rgba(228, 230, 236, 0.96) !important;
    border: 1px solid rgba(100, 102, 110, 0.45);
    border-radius: 5px;
    min-height: 28px;
    padding-left: 6px;
}
QComboBox:hover {
    background-color: rgba(48, 48, 52, 0.9);
    border: 1px solid rgba(120, 122, 130, 0.5);
}
QPushButton {
    background-color: rgba(45, 45, 50, 0.88);
    color: rgba(228, 230, 236, 0.96) !important;
    border: 1px solid rgba(100, 102, 110, 0.45);
    border-radius: 5px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: rgba(58, 58, 64, 0.9);
    border: 1px solid rgba(130, 132, 140, 0.48);
}
QPushButton:pressed {
    background-color: rgba(52, 52, 58, 0.92);
}
QCheckBox {
    spacing: 6px;
    color: rgba(224, 226, 232, 0.95) !important;
    font-size: 15px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator:unchecked {
    background-color: rgba(37, 37, 40, 0.9);
    border: 1px solid rgba(100, 102, 110, 0.5);
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: rgba(14, 99, 156, 0.82);
    border: 1px solid rgba(30, 120, 180, 0.65);
    border-radius: 3px;
}
QComboBox:focus, QPushButton:focus {
    border: 1px solid rgba(14, 99, 156, 0.65);
}
/* 滑条样式见各 QSlider 的 styleSheet 属性（Win 下父级 QSS 对 groove/handle 常不生效） */
QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    background-color: rgba(37, 37, 40, 0.88) !important;
    color: rgba(228, 230, 236, 0.96) !important;
    border: 1px solid rgba(100, 102, 110, 0.45);
    border-radius: 5px;
}
QSpinBox QLineEdit, QDoubleSpinBox QLineEdit, QAbstractSpinBox QLineEdit {
    background-color: transparent !important;
    color: rgba(228, 230, 236, 0.96) !important;
    border: none;
}
/* 4=HLine 5=VLine；银色分隔线 + 分割条 */
Line, QFrame[frameShape=&quot;4&quot;], QFrame[frameShape=&quot;5&quot;] {
    background-color: rgba(192, 194, 202, 0.88) !important;
    border: none;
    color: rgba(192, 194, 202, 0.88);
}
/* 与 cpp 中 splitter-&gt;setStyleSheet 一致；用 objectName 提高与主窗口全局 QSS 并存时的命中率 */
QWidget#igQtVariableCorrelationWidget QSplitter#splitter::handle:horizontal {
    background-color: rgba(192, 194, 202, 0.88);
    width: 3px;
    margin: 0 1px;
}
QWidget#igQtVariableCorrelationWidget QSplitter#splitter::handle:horizontal:hover {
    background-color: rgba(210, 212, 220, 0.95);
}
igQtVariableCorrelationWidget QRadioButton {
    color: rgba(224, 226, 232, 0.95) !important;
    background: transparent;
    spacing: 6px;
    font-size: 15px;
}
igQtVariableCorrelationWidget QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
igQtVariableCorrelationWidget QRadioButton::indicator:unchecked {
    background-color: rgba(37, 37, 40, 0.9);
    border: 1px solid rgba(100, 102, 110, 0.5);
    border-radius: 7px;
}
igQtVariableCorrelationWidget QRadioButton::indicator:checked {
    background-color: rgba(14, 99, 156, 0.75);
    border: 1px solid rgba(30, 120, 180, 0.55);
    border-radius: 7px;
}</string>
