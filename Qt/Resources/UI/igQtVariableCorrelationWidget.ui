    background-color: #3A4A6A;
    border-radius: 3px;
}
QSlider::add-page:horizontal {
    background-color: #383838;
    border: 1px solid #464646;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background-color: #B0B0B0;
    width: 12px;
    border-radius: 6px;
    margin: -4px 0;
}
QSlider::handle:horizontal:hover { background-color: #C8C8C8; }
QSlider::handle:horizontal:pressed { background-color: #B0B0B0; }</string>
