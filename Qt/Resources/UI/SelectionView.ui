  <property name="styleSheet">
   <string notr="true">/* ========== 全局基础样式 ========== */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-family: &quot;PingFang SC&quot;;
    font-size: 14px;
}

/* ========== DockWidget 整体 + 标题栏 ========== */
QDockWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    min-width: 350px; /* 适配你的UI宽度，避免内容挤压 */
}

/* Dock标题栏：解决显示不全+视觉清晰 */
QDockWidget::title {
    background-color: #252526 !important;
    border-bottom: 1px solid #3A3A3A !important;
    min-height: 36px !important;
    max-height: 36px !important;
    padding: 8px 12px !important; /* 内边距充足，文字不挤 */
    margin-right: 0 !important; /* 无按钮时释放全部宽度 */
    subcontrol-origin: margin !important;
    subcontrol-position: top left !important;
    text-align: left !important;
    vertical-align: middle !important;
    text-elide-mode: elide-right !important;
}

/* 隐藏标题栏按钮（释放文字空间） */
QDockWidget::close-button, QDockWidget::float-button {
    display: none !important;
}

/* ========== GroupBox 样式（解决内部拥挤核心） ========== */
QGroupBox {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    margin-top: 8px; /* 标题与内容间距 */
    padding-top: 12px; /* 标题下方内边距 */
}

/* GroupBox标题样式 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px; /* 标题左右内边距 */
    color: #CCCCCC;
    font-weight: 500;
}

/* ========== 复选框/单选框（解决文字拥挤） ========== */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    padding: 4px 6px; /* 文字与控件间距，解决拥挤 */
    margin: 3px 0; /* 控件上下间距，避免堆叠 */
}

/* 复选框指示器样式 */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    margin-right: 6px; /* 指示器与文字间距 */
}

QCheckBox::indicator:unchecked {
    background-color: #252526;
    border: 1px solid #3A3A3A;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #007ACC;
    border: 1px solid #007ACC;
    border-radius: 2px;
    image: url(:/icons/check.png); /* 可选：替换为勾选图标，无则删除 */
}

/* 单选框指示器样式 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    margin-right: 6px; /* 指示器与文字间距 */
}

QRadioButton::indicator:unchecked {
    background-color: #252526;
    border: 1px solid #3A3A3A;
    border-radius: 8px; /* 圆形 */
}

QRadioButton::indicator:checked {
    background-color: #007ACC;
    border: 1px solid #007ACC;
    border-radius: 8px;
}

/* ========== 按钮样式（舒展不拥挤 + 交互效果） ========== */
QPushButton {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px 12px; /* 内边距充足，文字不挤 */
    min-height: 28px; /* 按钮最小高度，避免压缩 */
}

QPushButton:hover {
    background-color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #4A4A4A;
}

/* 特殊按钮（如绘制包围框）适配 */
QPushButton#drawBoundBox {
    min-width: 80px; /* 强制宽度，避免文字挤压 */
}

/* ========== 输入框/下拉框/滑块 ========== */
QLineEdit, QDoubleSpinBox {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 4px 8px; /* 内边距，文字不贴边 */
    min-height: 28px;
}

QComboBox {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 28px;
}

QComboBox::drop-down {
    border-left: 1px solid #3A3A3A;
}

QSlider::groove:horizontal {
    height: 6px;
    background-color: #252526;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: #007ACC;
    border-radius: 8px;
    margin: -5px 0; /* 滑块居中 */
}

/* ========== 标签样式 ========== */
QLabel {
    color: #FFFFFF;
    padding: 2px 4px; /* 文字不贴边 */
}

QLabel#attention {
    color: #FF6B6B; /* 提示标签特殊颜色，可选 */
}

/* ========== 布局补充（兜底解决拥挤） ========== */
QVBoxLayout, QHBoxLayout, QGridLayout {
    spacing: 8px; /* 布局内控件间距 */
    contentsMargins: 8px; /* 布局内边距 */
}</string>
