<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1667</width>
    <height>1990</height>
   </rect>
  </property>
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
    <horstretch>0</horstretch>
    <verstretch>0</verstretch>
   </sizepolicy>
  </property>
  <property name="windowTitle">
   <string>iGameVis</string>
  </property>
  <property name="windowIcon">
   <iconset resource="../iGameQtMainWindow.qrc">
    <normaloff>:/Ticon/Icons/iGameLogo.png</normaloff>:/Ticon/Icons/iGameLogo.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ========== 全局字體（更順滑、減少鋸齒感） ========== */
* {
    font-family: &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 14pt;
}

/* ========== 主窗口整体 ========== */
QMainWindow {
    background-color: #1E1E1E; /* 主背景：深灰近黑 */
}

/* ========== 菜单栏（QMenuBar）整体样式 ========== */
QMenuBar {
    background-color: #181818; /* 菜单背景和全局统一 */
    color: #FFFFFF; /* 文字纯白 100%*/
    font-size: 12pt; /* 12号字体*/
    padding: 4px 0; /* 上下内边距，避免文字贴边 */
    border: none; /* 去掉默认边框 */
}

/* 菜单栏单个菜单项 */
QMenuBar::item {
    background: transparent;
    color: #FFFFFF; /* 文字色强制纯白 */
    padding: 4px 12px; /* 左右间距，适配点击区域 */
    margin: 0 2px;
    text-align: left; /* 左对齐 */
}

/* 菜单栏项选中态 */
QMenuBar::item:selected {
    background-color: #222222; /* 高亮背景，保持深色风格 */
    color: #FFFFFF; /* 选中后文字仍为纯白 100% */
    border-radius: 4px; /* 轻微圆角，更精致 */
}

/* ========== 下拉菜单（QMenu）样式 ========== */
QMenu {
    background-color: #181818; /* 下拉菜单背景，对齐全局 */
    color: #FFFFFF; /* 文字纯白 100% */
    font-size: 12pt; /* 12号字体 */
    border: 1px solid #333333; /* 轻边框，区分菜单区域 */
    border-radius: 4px; /* 圆角，适配风格 */
    padding: 4px 0; /* 上下内边距 */
}

/* 下拉菜单单个选项 */
QMenu::item {
    color: #FFFFFF; /* 文字纯白 100% */
    padding: 6px 24px; /* 左右大间距，适配左对齐阅读 */
    text-align: left; /* 左对齐 */
    border: none;
}

/* 下拉菜单项选中态（hover/点击） */
QMenu::item:selected {
    background-color: #222222; /* 高亮背景，不破坏深色风格 */
    color: #FFFFFF; /* 文字仍为纯白 100% */
    border-radius: 2px; /* 轻微圆角 */
}

/* 菜单分割线（可选，适配风格） */
QMenu::separator {
    height: 1px;
    background-color: #333333; /* 深灰分割线，不突兀 */
    margin: 4px 8px;
}

/* ========== 工具栏 ========== */
QToolBar {
    background-color: #181818; /* 工具栏背景（与菜单栏统一） */
    border: none; /* 去掉默认边框 */
}
QToolBar QToolButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 204);
    border: none;
    padding: 2px;   /* 減少內邊距，留更多空間給按鈕間距 */
    font-size: 8pt;
}
QToolBar QToolButton:hover {
    background-color: #3A3A3A; /* 按钮 hover 高亮 */
    border-radius: 2px;
}
QToolBar QToolButton:checked {
    background-color: rgba(255, 255, 255, 40); /* 选中态：浅灰底 */
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 2px;
}
QToolBar QToolButton:checked:hover {
    background-color: rgba(255, 255, 255, 55);
}
QToolBar QToolButton:pressed {
    background-color: #4A4A4A; /* 按钮按下效果 */
}
QToolBar::handle {
    /* 竖线样式：宽度2px，背景色#333333（深灰，适配深色风格），高度占满ToolBar */
    width: 2px;
    background-color: #333333;
    margin: 8px 0; /* 上下留一点边距，竖线不贴顶/底，更美观 */
}

/* 工具栏标题标签样式 */
QToolBar QLabel[objectName^=&quot;toolbarTitle&quot;] {
    color: #6B6B6B;
    font-size: 10pt;
    padding: 6px 8px 12px 8px;  /* 增加下边距到约12pt：top right bottom left */
    background-color: transparent;
    border: none;
}

/* ========== 停靠面板（DockWidget）- 优化版 ========== */
/* 整个DockWidget深色背景 + 圆角 */
QDockWidget {
    border-radius: 8px;
    border: none;
    color: #FFFFFF;
    font-size: 10pt;
}

/* 停靠(docked)状态：关闭按钮图标改为纯白（不改尺寸/位置，保持原来的观感） */
QDockWidget::close-button {
    image: url(:/Ticon/Icons/dock_close_white.svg);
    color: #FFFFFF;  /* 如果当前 style 使用文本方式绘制按钮，这里强制文字为白色 */
}

/* 标题栏 */
QDockWidget::title {
    background-color: #222222;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
    padding: 2px 8px;
    font: 12pt &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    line-height: 28px;
    color: #FFFFFF !important;
}
QDockWidget QWidget {
    background-color: #222222;
    color: rgba(255,255,255,204); /* 80% 透明白色文字 */
    font-size: 10pt !important;
}



/* 常见嵌套控件特殊处理 */
QDockWidget QScrollArea,
QDockWidget QScrollArea QWidget,
QDockWidget QFrame,
QDockWidget QTextEdit {
    background-color: #1E1E1E !important;
}

/* ========== DockWidget 中的 PushButton 样式（内边框设计） ========== */
/* 内边框效果：使用浅色边框（比背景亮），营造内嵌视觉，与深色背景协调 */
QDockWidget QPushButton {
    background-color: #2A2A2A; /* 按钮背景色，比 DockWidget 背景(#222222)稍亮 */
    color: rgba(255, 255, 255, 204); /* 文字颜色 */
    /* 内边框：浅色半透明边框，比背景色更亮，形成内嵌感 */
    border: 1px solid rgba(255, 255, 255, 20); /* 浅色边框，营造内边框效果 */
    border-radius: 4px;
    padding: 5px 12px; /* 适当的内边距 */
    min-height: 24px;
    font-size: 10pt;
}

/* Hover 状态：边框更明显，背景稍亮 */
QDockWidget QPushButton:hover {
    background-color: #2F2F2F; /* hover 时背景稍亮 */
    border: 1px solid rgba(255, 255, 255, 32); /* hover 时内边框更明显 */
}

/* Pressed 状态：按下时内缩效果 */
QDockWidget QPushButton:pressed {
    background-color: #252526; /* 按下时背景稍暗 */
    border: 1px solid rgba(255, 255, 255, 26);
    padding: 6px 13px 4px 11px; /* 按下时稍微内缩，增强按下感 */
}



/* ========== 分组框（QGroupBox） ========== */
QGroupBox {
    color: #CCCCCC;
    border: 1px solid #3A3A3A; /* 分组框边框 */
    border-radius: 4px;
    margin-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}

/* ========== 复选框/单选框 ========== */
QCheckBox, QRadioButton {
    color: #CCCCCC;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator:unchecked {
    background-color: #252526;
    border: 1px solid #3A3A3A;
    border-radius: 2px;
}
QCheckBox::indicator:checked {
    background-color: #007ACC; /* 选中时用科技蓝高亮（类似VS风格） */
    border: 1px solid #007ACC;
    border-radius: 2px;
    image: url(:/icons/check.png); /* 可替换为实际勾选图标 */
}

/* ========== 输入框/下拉框 ========== */
QLineEdit, QComboBox {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3A3A3A;
    border-radius: 2px;
    padding: 2px 4px;
}
QComboBox::drop-down {
    border-left: 1px solid #3A3A3A;
}
QComboBox::down-arrow {
    image: url(:/icons/down_arrow.png); /* 可替换为实际下拉箭头图标 */
    width: 10px;
    height: 10px;
}

/* ========== 滚动条 ========== */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4A4A4A;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0; /* 隐藏上下箭头 */
}

/* ========== 矢量场 Dock（dockWidget_VectorField）中的滑动条（QSlider） ========== */
/* 让滑动条与 Dock 深色背景 (#222222) 协调，减少高亮白色带来的晃眼感 */
QDockWidget#dockWidget_VectorField QSlider::groove:horizontal {
    background-color: #2A2A2A;      /* 比 Dock 背景略亮一点 */
    height: 6px;
    border-radius: 3px;
}

QDockWidget#dockWidget_VectorField QSlider::sub-page:horizontal {
    background-color: #3A4A6A;      /* 深蓝灰色高亮，低饱和不刺眼 */
    border-radius: 3px;
}

QDockWidget#dockWidget_VectorField QSlider::add-page:horizontal {
    background-color: #262626;      /* 未激活部分更暗，贴近背景 */
    border-radius: 3px;
}

QDockWidget#dockWidget_VectorField QSlider::handle:horizontal {
    background-color: #B0B0B0;      /* 中灰色手柄，去掉刺眼的纯白 */
    width: 12px;
    border-radius: 6px;
    margin: -4px 0;                 /* 让手柄略微溢出槽，高级一点的视觉 */
}

QDockWidget#dockWidget_VectorField QSlider::handle:horizontal:hover {
    background-color: #C8C8C8;      /* 悬停时稍微变亮，但依旧不是纯白 */
}

/* ========== 标签页（TabWidget） ========== */
QTabWidget::pane {
    border: 1px solid #3A3A3A;
    background-color: #1E1E1E;
}
QTabBar::tab {
    background-color: #252526;
    color: #CCCCCC;
    padding: 4px 12px;
    border: 1px solid #3A3A3A;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #1E1E1E;
    border-bottom-color: #1E1E1E; /* 选中时与面板背景融合 */
}
QMainWindow QToolBar,
QMainWindow QLabel, QMainWindow QPushButton, QMainWindow QCheckBox, QMainWindow QRadioButton,
QMainWindow QLineEdit, QMainWindow QComboBox, QMainWindow QGroupBox, QMainWindow QTabBar, QMainWindow QTextEdit,
QMainWindow QSpinBox, QMainWindow QDoubleSpinBox, QMainWindow QSlider, QMainWindow QProgressBar {
    color: #FFFFFF; /* 设计师指定的字体色：纯白 RGB(255,255,255) */
}

/* 狀態欄字體：略小於全局，但比剛才大兩號（包含 Ready for 文本） */
QStatusBar {
    font-size: 10pt;
}

/* 狀態欄內進度條右側的數字等文字與狀態欄保持一致字號 */
QStatusBar QProgressBar,
QStatusBar QLabel {
    font-size: 10pt;
}

/* 1. 属性面板整体控件 */
QtTreePropertyBrowser, QtPropertyBrowser {
    background-color: #1E1E1E; /* 对齐你的深色背景 */
    color: rgba(255, 255, 255, 204) !important; /* 文字白色 80% */
    font-size: 14pt;
}

/* 2. 属性分组标题（对应objectGroup的标题） */
QtPropertyEditorView QGroupBox,
QtPropertyBrowser QGroupBox,
QtTreePropertyBrowser QGroupBox {
    color: rgba(255, 255, 255, 204) !important; /* 分组标题文字白色 80% */
    border: 1px solid #3A3A3A;
    background-color: #252526;
}

/* 3. 属性面板的行项目（分组内的属性文字） */
QtPropertyEditorView QLabel,
QtPropertyEditorView QWidget,
QtTreePropertyBrowser QLabel,
QtTreePropertyBrowser QWidget {
    color: rgba(255, 255, 255, 204) !important; /* 强制所有子元素文字白色 80% */
    background-color: transparent;
}

/* 4. 属性面板表格行交替颜色 */
QtTreePropertyBrowser QTreeWidget,
QtPropertyEditorView {
    alternate-background-color: #272727; /* 交替行背景色 */
    background-color: #222222; /* 默认行背景色 */
}
QtTreePropertyBrowser QTreeWidget::item,
QtPropertyEditorView::item {
    background-color: #222222;
    color: rgba(255, 255, 255, 204); /* 文字白色 80% */
}
QtTreePropertyBrowser QTreeWidget::item:alternate,
QtPropertyEditorView::item:alternate {
    background-color: #272727;
    color: rgba(255, 255, 255, 204); /* 文字白色 80% */
}
QtTreePropertyBrowser QTreeWidget::item:selected,
QtPropertyEditorView::item:selected {
    background-color: #3A3A3A;
    color: rgba(255, 255, 255, 204); /* 文字白色 80% */
}
QtTreePropertyBrowser QTreeWidget::item:hover,
QtPropertyEditorView::item:hover {
    background-color: #2A2A2A;
    color: rgba(255, 255, 255, 204); /* 文字白色 80% */
}

/* 5. 兜底：覆盖所有未匹配的子控件（防止漏网） */
QtTreePropertyBrowser * {
    color: rgba(255, 255, 255, 204) !important; /* !important 强制覆盖默认样式 白色 80% */
    background-color: inherit;
}

/* ========== 悬浮圖層樹 LayerTreeDock 樣式（只定義這一個 Dock，避免影響其他 Properties Dock） ========== */

QDockWidget#LayerTreeDock {
    background-color: #222222;
    /* QDockWidget 自身不畫邊框（邊框由 titleBar + 內容區拼起來畫） */
    border: none;
    border-radius: 0;
    font-family: &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 10pt;
}

/* 讓 LayerTreeDock 的內容區與標題欄共同拼出整圈邊框：內容畫左/右/下，標題畫上/左/右 */
QDockWidget#LayerTreeDock igQtModelTreeWidget#modelTreeWidget,
QDockWidget#LayerTreeDock QWidget#modelTreeWidget,
QDockWidget#LayerTreeDock QWidget[objectName="modelTreeWidget"] {
    margin: 0;
    /* 第二列自訂 widget 所在區域背景，與整體一致，避免出現獨立黑色矩形 */
    background-color: #222222;
    /* 1pt 邊框：約等於 1px，alpha = 26 ≈ 10% 不透明度 */
    border-left: 1px solid rgba(255, 255, 255, 26);
    border-right: 1px solid rgba(255, 255, 255, 26);
    border-bottom: 1px solid rgba(255, 255, 255, 26);
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* Tree 中第二列那個承載若干按鈕的容器本身（buttonWidget），預設是 QWidget，沒設樣式時會顯示系統默認黑底。
   這裡強制讓它透明，讓背景透出 #222222，不再看到一塊純黑矩形。 */
QDockWidget#LayerTreeDock igQtModelTreeWidget#modelTreeWidget QWidget {
    background-color: transparent;
    border: none;
}

/* LayerTreeDock 無邊框 floating 時的自訂標題欄（上邊 + 左右邊 + 上圓角） */
QDockWidget#LayerTreeDock QWidget#DockTitleBar {
    background-color: #222222;
    margin: 0;
    border-left: 1px solid rgba(255, 255, 255, 26);
    border-right: 1px solid rgba(255, 255, 255, 26);
    border-top: 1px solid rgba(255, 255, 255, 26);
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
QDockWidget#LayerTreeDock QLabel#DockTitleLabel {
    color: #FFFFFF;
    font-size: 12pt;
    background: transparent;
}
QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton {
    color: #FFFFFF;
    background: transparent;
    border: none;
    font-size: 14pt;
}
QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton:hover {
    background-color: rgba(255, 255, 255, 18);
    border-radius: 7px;
}

/* 标题：左对齐、留出右侧按钮空间 */
QDockWidget#LayerTreeDock::title {
    background-color: rgba(24, 24, 24, 0);
    color: #FFFFFF; /* 标题文字白色 100% */
    padding: 10px 64px 10px 14px;
    min-height: 40px;
    max-height: 40px;
    font: 12pt &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-weight: 600;
    text-align: left;
}

/* 右上角按钮（浮动/关闭） */
QDockWidget#LayerTreeDock::float-button,
QDockWidget#LayerTreeDock::close-button {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    width: 26px;
    height: 26px;
    margin-top: 7px;
    border: none;
    background: transparent;
}
QDockWidget#LayerTreeDock::close-button {
    /* 覆盖全局 close-button，确保图层树 Dock 的关闭按钮也是白色 */
    image: url(:/Ticon/Icons/dock_close_white.svg);
    color: #FFFFFF;
}
QDockWidget#LayerTreeDock::float-button { right: 40px; }
QDockWidget#LayerTreeDock::close-button { right: 10px; }

QDockWidget#LayerTreeDock::float-button:hover,
QDockWidget#LayerTreeDock::close-button:hover {
    background-color: rgba(255, 255, 255, 18);
    border-radius: 7px;
}

/* 彻底去掉内部白边：viewport / frame / scrollarea */
QDockWidget#LayerTreeDock QWidget,
QDockWidget#LayerTreeDock QFrame,
QDockWidget#LayerTreeDock QScrollArea,
QDockWidget#LayerTreeDock QAbstractScrollArea,
QDockWidget#LayerTreeDock QAbstractScrollArea::viewport {
    background-color: rgba(24, 24, 24, 255);
    border: none;
    font-family: &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 10pt;
}

/* 树内容：行高、交替底色、hover/选中效果（接近截图） */
QDockWidget#LayerTreeDock QTreeWidget {
    /* 整個 LayerDialog 樹的背景與 Dock 一致，避免載入數據後左側出現純黑條 */
    background-color: #222222;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 204); /* 内容文字白色 80% */
    alternate-background-color: rgba(255, 255, 255, 10);
    show-decoration-selected: 1;
    font-family: &quot;PingFang SC Regular&quot;, &quot;PingFang SC&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 10pt;
}

QDockWidget#LayerTreeDock QTreeWidget::item {
    border: none;
    padding: 4px 10px;
    min-height: 32px;
}
QDockWidget#LayerTreeDock QTreeWidget::item:alternate {
    background-color: rgba(255, 255, 255, 8);
}
QDockWidget#LayerTreeDock QTreeWidget::item:hover {
    background-color: rgba(255, 255, 255, 14);
}
QDockWidget#LayerTreeDock QTreeWidget::item:selected {
    background-color: rgba(255, 255, 255, 20);
    color: rgba(255, 255, 255, 204); /* 选中文字白色 80% */
}

/* 让分支/展开箭头区背景也與整體一致，避免左側縮進區變成黑色條 */
QDockWidget#LayerTreeDock QTreeWidget::branch {
    background-color: #222222;
}

/* 滚动条（细、深色） */
QDockWidget#LayerTreeDock QScrollBar:vertical {
    background: rgba(0, 0, 0, 0);
    width: 10px;
    margin: 6px 2px 6px 2px;
}
QDockWidget#LayerTreeDock QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 35);
    border-radius: 5px;
    min-height: 24px;
}
QDockWidget#LayerTreeDock QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 55);
}
QDockWidget#LayerTreeDock QScrollBar::add-line:vertical,
QDockWidget#LayerTreeDock QScrollBar::sub-line:vertical {
    height: 0;
}

/* ========== Properties Dock 样式 ========== */
/* LayerPropertiesDock 使用全局 QDockWidget::title 样式即可 */
</string>
