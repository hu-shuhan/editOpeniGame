        <property name="text">
         <string notr="true">QColorDialog { background-color: #1E1E1E; color: #D0D0D0; border: 2px solid #4A4A4A; border-radius: 10px; }
QWidget { background-color: #1E1E1E; color: #D0D0D0; }
QGroupBox { border: 1px solid #3A3A3A; border-radius: 4px; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #E0E0E0; }
QLineEdit, QSpinBox, QComboBox { background-color: #252526; color: #E0E0E0; border: 1px solid #3C3C3C; border-radius: 4px; min-height: 28px; padding: 0 8px; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #0E639C; }
QPushButton { background-color: #2D2D30; color: #E0E0E0; border: 1px solid #3C3C3C; border-radius: 4px; min-height: 30px; padding: 0 10px; }
QPushButton:hover { background-color: #3A3A3D; }
QPushButton:pressed { background-color: #45454A; }
QCheckBox { spacing: 6px; }
QCheckBox::indicator { width: 14px; height: 14px; }
QCheckBox::indicator:unchecked { background-color: #252526; border: 1px solid #3C3C3C; border-radius: 2px; }
QCheckBox::indicator:checked { background-color: #0E639C; border: 1px solid #0E639C; border-radius: 2px; }
QAbstractItemView { outline: none; }
QAbstractItemView::item:selected { border: 2px solid #0E639C; background: rgba(14, 99, 156, 0.18); color: #E0E0E0; }
QAbstractItemView::item:hover { border: 1px solid #5A5A5A; }</string>
